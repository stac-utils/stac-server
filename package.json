{
  "displayName": "stac-server",
  "description": "A STAC API running on stac-server",
  "version": "v5.0.0",
  "repository": "https://github.com/stac-utils/stac-server",
  "author": "stac-server contributors",
  "license": "MIT",
  "type": "module",
  "moduleDirectories": [
    "node_modules",
    "src"
  ],
  "scripts": {
    "build": "./bin/build.sh",
    "build-lambda-dist": "./bin/build-lambda-dist.sh",
    "lint": "eslint . --ext .js,.ts",
    "lint-js-fix": "eslint . --ext .js,.ts --fix",
    "check-openapi": "spectral lint src/lambdas/api/openapi.yaml --ruleset .spectral.yml",
    "test": "npm run test:unit && npm run test:system",
    "test:system": "./bin/system-tests.sh",
    "test:system:coverage": "c8 npm run test:system",
    "test:unit": "ava tests/unit/*.[tj]s",
    "test:unit:coverage": "c8 npm run test:unit",
    "typecheck": "tsc && tsc -p tsconfig.test.json",
    "audit-prod": "npx better-npm-audit audit --production",
    "audit": "npx better-npm-audit audit",
    "deploy": "sls deploy",
    "sls-remove": "sls remove",
    "package": "sls package",
    "serve": "REQUEST_LOGGING_FORMAT=dev LOG_LEVEL=debug STAC_API_URL=http://localhost:3000 ENABLE_TRANSACTIONS_EXTENSION=true nodemon --exec node --import=tsx ./src/lambdas/api/local.ts",
    "build-api-docs": "npx @redocly/cli build-docs src/lambdas/api/openapi.yaml -o ./docs/api-spec.html",
    "prepare": "husky",
    "ingest:example": "node bin/ingest-example.js"
  },
  "ava": {
    "verbose": true,
    "timeout": "1m",
    "extensions": [
      "ts"
    ],
    "nodeArguments": [
      "--import=tsx"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/stac-utils/stac-server/issues"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-secrets-manager": "^3.1146.0",
    "@aws-sdk/client-sns": "^3.1146.0",
    "@aws-sdk/client-sqs": "^3.1146.0",
    "@aws-sdk/credential-provider-node": "^3.972.13",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@mapbox/extent": "^0.4.0",
    "@opensearch-project/opensearch": "^2.13.0",
    "@redocly/cli": "^2.57.0",
    "ansi-regex": "<6.4.1 || >6.2.1",
    "ansi-styles": "<6.2.4 || >6.2.2",
    "chalk": "<5.6.3 || >5.6.1",
    "color-convert": "<3.1.1 || >3.1.1",
    "color-name": "<2.1.2 || >2.0.1",
    "color-string": "<2.1.1 || >2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "debug": "<4.4.2 || >4.4.2",
    "express": "^4.21.2",
    "got": "^15.0.5",
    "http-errors": "^2.0.1",
    "is-arrayish": "<0.3.5 || >0.3.3",
    "lodash-es": "^4.17.23",
    "morgan": "^1.11.0",
    "serverless-http": "^4.0.0",
    "simple-swizzle": "<0.2.5 || >0.2.3",
    "strip-ansi": "<7.1.1 || >7.1.1",
    "supports-color": "<10.2.1 || >10.2.1",
    "ts-loader": "^9.6.1",
    "winston": "^3.19.0",
    "wrap-ansi": "<10.0.3 || >9.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@smithy/types": "^4.19.0",
    "@stoplight/spectral-cli": "^6.17.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/aws-lambda": "^8.10.164",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/eslint": "^9.6.1",
    "@types/express": "^4.17.25",
    "@types/geojson": "^7946.0.16",
    "@types/http-errors": "^2.0.5",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.7.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.14",
    "@types/webpack": "^5.28.5",
    "@types/zip-webpack-plugin": "^3.0.6",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.57.1",
    "ava": "5.3",
    "aws-sdk-client-mock": "^4.1.0",
    "better-npm-audit": "^3.11.0",
    "c8": "^11.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "crypto-random-string": "^6.0.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.1.0",
    "husky": "^9.1.7",
    "luxon": "^3.7.2",
    "nock": "^14.0.17",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "prettier-eslint": "^17.1.2",
    "prettier-eslint-cli": "^9.2.1",
    "serverless": "^4.33.0",
    "serverless-offline": "^14.5.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "zip-webpack-plugin": "^4.0.3"
  },
  "name": "stac-server",
  "engines": {
    "node": ">=22"
  }
}
